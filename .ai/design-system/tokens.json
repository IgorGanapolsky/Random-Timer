{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_meta": {
    "name": "标准企业中台",
    "description": "Ant Design 蓝色企业风，适用于管理后台、报表系统、中台项目",
    "version": "1.0.0"
  },
  "color": {
    "brand": {
      "primary": { "value": "#1677ff", "description": "主色-品牌蓝" },
      "primary-hover": { "value": "#4096ff" },
      "primary-active": { "value": "#0958d9" },
      "primary-bg": { "value": "#e6f4ff", "description": "主色浅底（选中行、标签底色）" }
    },
    "functional": {
      "success": { "value": "#52c41a", "description": "成功/通过/上升" },
      "success-bg": { "value": "#f6ffed" },
      "warning": { "value": "#faad14", "description": "警告/待处理" },
      "warning-bg": { "value": "#fffbe6" },
      "error": { "value": "#ff4d4f", "description": "错误/失败/下降" },
      "error-bg": { "value": "#fff2f0" },
      "info": { "value": "#1677ff", "description": "信息提示" },
      "info-bg": { "value": "#e6f4ff" }
    },
    "neutral": {
      "title": { "value": "rgba(0,0,0,0.88)", "description": "标题文字" },
      "text": { "value": "rgba(0,0,0,0.88)", "description": "正文文字" },
      "secondary": { "value": "rgba(0,0,0,0.65)", "description": "辅助文字" },
      "placeholder": { "value": "rgba(0,0,0,0.25)", "description": "占位符" },
      "disabled": { "value": "rgba(0,0,0,0.25)", "description": "禁用态文字" },
      "border": { "value": "#d9d9d9", "description": "边框/分割线" },
      "divider": { "value": "rgba(0,0,0,0.06)" }
    },
    "background": {
      "page": { "value": "#f5f5f5", "description": "页面底色" },
      "container": { "value": "#ffffff", "description": "卡片/容器底色" },
      "hover": { "value": "#f5f5f5", "description": "行悬停" },
      "selected": { "value": "#e6f4ff", "description": "选中行" },
      "stripe": { "value": "#fafafa", "description": "表格斑马纹" }
    }
  },
  "spacing": {
    "unit": { "value": "4px", "description": "基础单位，所有间距必须是 4 的倍数" },
    "xs": { "value": "4px" },
    "sm": { "value": "8px" },
    "md": { "value": "16px" },
    "lg": { "value": "24px" },
    "xl": { "value": "32px" },
    "xxl": { "value": "48px" },
    "page-padding": { "value": "24px", "description": "页面内容区内边距" },
    "card-padding": { "value": "24px", "description": "卡片内边距" },
    "card-gap": { "value": "16px", "description": "卡片之间间距" },
    "form-item-gap": { "value": "24px", "description": "表单项垂直间距" },
    "section-gap": { "value": "24px", "description": "页面区块间距" }
  },
  "typography": {
    "font-family": {
      "value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "description": "系统默认字体栈"
    },
    "font-family-code": {
      "value": "'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace"
    },
    "page-title": { "size": "20px", "weight": "600", "line-height": "28px", "description": "页面标题" },
    "card-title": { "size": "16px", "weight": "600", "line-height": "24px", "description": "卡片标题" },
    "body": { "size": "14px", "weight": "400", "line-height": "22px", "description": "正文" },
    "body-strong": { "size": "14px", "weight": "600", "line-height": "22px", "description": "加粗正文" },
    "caption": { "size": "12px", "weight": "400", "line-height": "20px", "description": "辅助说明/标签" },
    "stat-value": { "size": "30px", "weight": "600", "line-height": "38px", "description": "统计数字" }
  },
  "radius": {
    "sm": { "value": "4px", "description": "小元素（标签、Badge）" },
    "md": { "value": "6px", "description": "按钮、输入框、卡片" },
    "lg": { "value": "8px", "description": "弹窗、大卡片" },
    "full": { "value": "9999px", "description": "圆形头像、胶囊按钮" }
  },
  "shadow": {
    "none": { "value": "none" },
    "sm": { "value": "0 1px 2px 0 rgba(0,0,0,0.03), 0 1px 6px -1px rgba(0,0,0,0.02), 0 2px 4px 0 rgba(0,0,0,0.02)", "description": "卡片默认" },
    "md": { "value": "0 6px 16px 0 rgba(0,0,0,0.08), 0 3px 6px -4px rgba(0,0,0,0.12), 0 9px 28px 8px rgba(0,0,0,0.05)", "description": "悬浮、下拉" },
    "lg": { "value": "0 12px 40px 0 rgba(0,0,0,0.12)", "description": "弹窗" }
  },
  "breakpoint": {
    "sm": { "value": "576px" },
    "md": { "value": "768px" },
    "lg": { "value": "992px" },
    "xl": { "value": "1200px" },
    "xxl": { "value": "1600px" }
  },
  "layout": {
    "sider-width": { "value": "220px", "description": "侧边栏宽度" },
    "sider-collapsed-width": { "value": "64px", "description": "侧边栏折叠宽度" },
    "header-height": { "value": "56px", "description": "顶栏高度" },
    "content-max-width": { "value": "1600px", "description": "内容区最大宽度" }
  }
}
