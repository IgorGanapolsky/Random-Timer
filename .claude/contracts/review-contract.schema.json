{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://random-timer.local/contracts/review-contract.schema.json",
  "title": "ReviewContract",
  "type": "object",
  "required": ["verdict", "summary", "issues"],
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "REQUEST_CHANGES", "BLOCK"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "file", "line", "description", "suggestion"],
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "major", "minor", "style"]
          },
          "status": {
            "type": "string",
            "enum": ["open", "fixed", "accepted_risk"]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "suggestion": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
