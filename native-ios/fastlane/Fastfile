default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # Increment build number
    increment_build_number(xcodeproj: "RandomTimer.xcodeproj")

    # Get certificates and provisioning profiles
    match(
      type: "appstore",
      app_identifier: ["com.iganapolsky.randomtimer", "com.iganapolsky.randomtimer.widget"],
      readonly: false
    )

    # Build the app
    build_app(
      scheme: "RandomTimer",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.iganapolsky.randomtimer" => "match AppStore com.iganapolsky.randomtimer",
          "com.iganapolsky.randomtimer.widget" => "match AppStore com.iganapolsky.randomtimer.widget"
        }
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Create app in App Store Connect"
  lane :create_app do
    produce(
      app_identifier: "com.iganapolsky.randomtimer",
      app_name: "Random Timer",
      language: "en-US",
      app_version: "1.0",
      sku: "randomtimer001",
      team_id: ENV["FASTLANE_TEAM_ID"]
    )
  end

  desc "Setup certificates and profiles"
  lane :setup do
    match(
      type: "appstore",
      app_identifier: ["com.iganapolsky.randomtimer", "com.iganapolsky.randomtimer.widget"],
      readonly: false,
      force_for_new_devices: true
    )
  end
end
