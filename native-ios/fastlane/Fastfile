default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # Increment build number
    increment_build_number(xcodeproj: "RandomTimer.xcodeproj")

    # Use App Store Connect API key if available
    if ENV["APPSTORE_KEY_ID"] && ENV["APPSTORE_ISSUER_ID"]
      api_key = app_store_connect_api_key(
        key_id: ENV["APPSTORE_KEY_ID"],
        issuer_id: ENV["APPSTORE_ISSUER_ID"],
        key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APPSTORE_KEY_ID']}.p8")
      )
    end

    # Build with automatic signing
    build_app(
      scheme: "RandomTimer",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates"
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      api_key: defined?(api_key) ? api_key : nil
    )
  end

  desc "Create app in App Store Connect"
  lane :create_app do
    produce(
      app_identifier: "com.igorganapolsky.randomtimer",
      app_name: "Random Tactical Timer",
      language: "en-US",
      app_version: "1.1.0",
      sku: "randomtimer001",
      team_id: ENV["FASTLANE_TEAM_ID"]
    )
  end

  desc "Upload metadata (screenshots, descriptions) to App Store Connect"
  lane :metadata do
    if ENV["APPSTORE_KEY_ID"] && ENV["APPSTORE_ISSUER_ID"]
      api_key = app_store_connect_api_key(
        key_id: ENV["APPSTORE_KEY_ID"],
        issuer_id: ENV["APPSTORE_ISSUER_ID"],
        key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APPSTORE_KEY_ID']}.p8")
      )
    end

    deliver(
      app_identifier: "com.igorganapolsky.randomtimer",
      skip_binary_upload: true,
      skip_screenshots: false,
      force: true,
      api_key: defined?(api_key) ? api_key : nil
    )
  end

  desc "Setup certificates and profiles"
  lane :setup do
    if ENV["MATCH_GIT_URL"]
      match(
        type: "appstore",
        app_identifier: ["com.igorganapolsky.randomtimer", "com.igorganapolsky.randomtimer.widget"],
        readonly: false,
        force_for_new_devices: true
      )
    else
      UI.message("No MATCH_GIT_URL set - using Xcode automatic signing")
    end
  end
end
