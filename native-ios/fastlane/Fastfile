default_platform(:ios)

platform :ios do
  desc "Deploy a new version to TestFlight and Firebase App Distribution"
  lane :deploy do
    # Setup code signing
    setup_ci if ENV["CI"]
    
    # Build and upload to TestFlight
    build_app(
      scheme: "RandomTimer",
      workspace: "RandomTimer.xcworkspace",
      export_method: "app-store",
      output_directory: "build"
    )
    
    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      username: ENV["FASTLANE_USER"],
      app_identifier: "com.igorganapolsky.randomtimer"
    )
    
    # Also upload to Firebase App Distribution
    firebase_app_distribution(
      app: ENV["FIREBASE_IOS_APP_ID"],
      firebase_cli_token: ENV["FIREBASE_TOKEN"],
      release_notes: "Automated build from GitHub Actions",
      groups: "internal-testers"
    )
  end
end
